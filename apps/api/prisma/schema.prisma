// Prisma schema — the single source of truth for the database structure.
// Docs: https://pris.ly/d/prisma-schema
// Targets Prisma 6.x — datasource `url` via env() is correct for this version.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique // stored lowercased/trimmed
  passwordHash  String
  name          String
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the opaque token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @default("")
  // Money is stored as an integer in paise to avoid floating-point errors.
  priceInPaise Int
  currency     String   @default("INR")
  imageUrl     String?
  // Primary colour shown as a swatch dot on the storefront (hex, e.g. "#C0392B").
  color        String?
  stock        Int      @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)

  // Totals are snapshotted in paise at purchase time.
  subtotalInPaise Int
  currency        String @default("INR")

  // Shipping address snapshot (so it never changes if the user edits later).
  shippingName       String
  shippingPhone      String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot of the product at purchase time (name/price can change later).
  name         String
  priceInPaise Int
  size         String
  quantity     Int

  @@index([orderId])
}
