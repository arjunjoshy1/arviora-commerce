# Copy this file to .env and adjust as needed.
# Local Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://arviora:arviora@localhost:5432/arviora?schema=public"

# API
API_PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Auth — generate strong random values for production
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECRET="dev-cookie-secret-change-me"
APP_WEB_URL="http://localhost:5173"
